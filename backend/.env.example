# Database Configuration (Neon PostgreSQL / Supabase)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVER_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require

# Modular AI Service Key (Optional: Gemini / OpenAI API Key)
AI_API_KEY=
AI_PROVIDER=gemini

# OCR Binary Path (Optional override if tesseract executable is in custom path)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
